@model List<BookstorePlatform.Web.Classes.Cart_Book>
@{
    var culture = new System.Globalization.CultureInfo("en-US");
}

<h1 class="text-center">Shopping Cart</h1>

@foreach (var cartBook in Model)
{
    var book = cartBook.Book;
    <div class="cart-item row mb-3 align-items-center">
        <!-- Add align-items-center class here -->
        <div class="col-md-2 d-flex align-items-center">
            <img src="@(book?.CoverImg ?? string.Empty)" alt="Book Cover" class="book-cover img-fluid" style="width: 100px; height: 150px;">
        </div>
        <div class="col-md-4 d-flex align-items-center">
            <h2>@(book?.Title ?? "Unknown title")</h2>
        </div>
        <div class="col-md-2">
            <form method="post" action="@Url.Action("UpdateQuantity", "Cart")">
                <input type="hidden" name="cartBookId" value="@cartBook.Id" />
                <div class="input-group">
                    <input type="number" name="quantity" value="@cartBook.Quantity" class="form-control" min="1" />
                    <div class="input-group-append">
                        <button type="submit" class="btn btn-outline-secondary">Update</button>
                    </div>
                </div>
            </form>
        </div>
        <div class="col-md-2 d-flex align-items-center">
            <h4>Price: R @(book?.Price ?? "0.00")</h4>
        </div>
        <div class="col-md-2 d-flex align-items-center">
            <button class="btn btn-danger" onclick="deleteBook(@cartBook.Id)">Delete</button>
        </div>
    </div>
}


<!-- Total -->
<div class="row mt-5">
    <div class="col-md-8"></div>
    <div class="col-md-4">
        <h3>
            Total: R @{
                decimal total = 0;
                foreach (var cartBook in Model)
                {
                    int quantity = Convert.ToInt32(cartBook.Quantity);
                    var priceText = cartBook.Book?.Price;
                    if (decimal.TryParse(priceText, System.Globalization.NumberStyles.Any, culture, out var price))
                    {
                        total += quantity * price;
                    }
                }
                @total
            }
        </h3>

    </div>
</div>

<!-- Checkout and Continue Shopping Buttons -->
<div class="row mt-3">
    <div class="col-md-8"></div>
    <div class="col-md-2">
        <a href="@Url.Action("ViewOrder", "Order")" class="btn btn-primary btn-block">Checkout</a>
    </div>
    <div class="col-md-2">
        <a href="@Url.Action("Index", "Browse")" class="btn btn-secondary btn-block">Continue Shopping</a>
    </div>
</div>


@section Scripts {
    <script>
        function deleteBook(cartBookId) {
            if (confirm('Are you sure you want to delete this book from your cart?')) {
                $.ajax({
                    url: '@Url.Action("DeleteBookFromCart", "Cart")',
                    type: 'POST',
                    data: { cartBookId: cartBookId },
                    success: function () {
                        // Reload the page after successful deletion
                        window.location.reload();
                    },
                    error: function () {
                        alert('Error occurred while deleting the book from cart.');
                    }
                });
            }
        }
    </script>
}
