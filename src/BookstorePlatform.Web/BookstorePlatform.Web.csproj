<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <NuGetAuditLevel>high</NuGetAuditLevel>
    <UserSecretsId>aspnet-BookstorePlatform.Web</UserSecretsId>
    <RootNamespace>BookstorePlatform.Web</RootNamespace>
    <AssemblyName>BookstorePlatform.Web</AssemblyName>
    <ApplicationIcon>book.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="book.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Resource>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CoreAdmin" Version="2.7.1" />
    <PackageReference Include="Microsoft.AspNetCore.Components.QuickGrid.EntityFrameworkAdapter" Version="10.0.6" />
    <PackageReference Include="Microsoft.AspNetCore.Diagnostics.EntityFrameworkCore" Version="10.0.6" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.UI" Version="10.0.6" />
    <PackageReference Include="Microsoft.VisualStudio.Web.CodeGeneration.Design" Version="10.0.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BookstorePlatform.Application\BookstorePlatform.Application.csproj" />
    <ProjectReference Include="..\BookstorePlatform.Domain\BookstorePlatform.Domain.csproj" />
    <ProjectReference Include="..\BookstorePlatform.Infrastructure\BookstorePlatform.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Data\**\*.cs" />
    <Compile Remove="Migrations\**\*.cs" />
    <Compile Remove="Classes\**\*.cs" />
    <Compile Remove="Areas\Identity\Data\StoreUser.cs" />
    <Compile Remove="Areas\Identity\Data\Address.cs" />
  </ItemGroup>

</Project>
